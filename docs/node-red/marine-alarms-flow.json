    {
        "id": "n_fn_apply_action",
        "type": "function",
        "z": "487e7fdff6aeea0c",
        "name": "Apply Alarm Action",
        "func": "const body = typeof msg.payload === 'string' ? JSON.parse(msg.payload || '{}') : (msg.payload || {});\nconst incomingId = body.id || '';\nlet action = body.action || '';\nif (action === 'clear') action = 'acknowledge';\n\nfunction respond(code, payload) {\n    return [null, { ...msg, statusCode: code, payload: payload, headers: { 'Access-Control-Allow-Origin': '*' } }, null];\n}\n\nif (!incomingId || !['silence', 'acknowledge'].includes(action)) {\n    return respond(400, { ok: false, error: 'invalid id or action' });\n}\n\nlet alarms = global.get('activeAlarms') || {};\nconst key = Object.keys(alarms).find((k) => k === incomingId || alarms[k].path === incomingId);\n\nif (!key) {\n    return respond(404, { ok: false, error: 'alarm not currently active' });\n}\n\nconst alarm = alarms[key];\n\nif (action === 'silence') {\n    alarm.silenced = true;\n    alarm.silencedUntil = Date.now() + 30 * 60 * 1000;\n} else {\n    alarm.acknowledged = true;\n}\nalarms[key] = alarm;\nglobal.set('activeAlarms', alarms);\n\nconst stopMsg = { topic: key, payload: 'STOP' };\nconst expireMsg = action === 'silence' ? { topic: key, alarm_key: key } : null;\nconst responseMsg = {\n    ...msg,\n    statusCode: 200,\n    headers: { 'Access-Control-Allow-Origin': '*' },\n    payload: { ok: true, id: key, silenced: !!alarm.silenced, acknowledged: !!alarm.acknowledged }\n};\n\nreturn [stopMsg, responseMsg, expireMsg];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
