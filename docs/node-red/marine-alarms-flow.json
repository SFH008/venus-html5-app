                "1de2b68bfdb13bfa"
            ]
        ]
    },
    {
        "id": "cb886f5692170d07",
        "type": "function",
        "z": "487e7fdff6aeea0c",
        "name": "Hysteresis gate",
        "func": "const REARM_MS = {\n    emergency:  60 * 1000,\n    alarm:       5 * 60 * 1000,\n    warn:       15 * 60 * 1000,\n    normal:     0\n};\n\nconst id    = msg.alarm_id;\nconst state = msg.alarm_state;\nconst now   = Date.now();\n\nlet alarms = global.get('activeAlarms') || {};\n\nif (state === 'normal') {\n    if (alarms[id]) {\n        alarms[id].lastCleared = now;\n        global.set('activeAlarms', alarms);\n    }\n    return msg;\n}\n\nconst alarm       = alarms[id] || {};\nconst lastCleared = alarm.lastCleared || 0;\nconst window      = REARM_MS[state] ?? REARM_MS.warn;\nconst elapsed     = now - lastCleared;\n\nif (elapsed < window) {\n    const remaining = Math.round((window - elapsed) / 1000);\n    node.warn(`[HYSTERESIS] ${id} suppressed (${state}) - re-arm in ${remaining}s`);\n    node.status({ fill: 'yellow', shape: 'ring', text: `${id} suppressed ${remaining}s` });\n    return null;\n}\n\nalarm.lastAnnounced = now;\nalarms[id] = alarm;\nglobal.set('activeAlarms', alarms);\n\nnode.status({ fill: 'green', shape: 'dot', text: `${id} passed` });\nreturn msg;\n",
        "outputs": 1,
        "x": 800,
        "y": 160,
        "wires": [
