    {
        "id": "n_fn_expire",
        "type": "function",
        "z": "487e7fdff6aeea0c",
        "name": "Expire Silence",
        "func": "const key = msg.alarm_key;\nlet alarms = global.get('activeAlarms') || {};\nconst alarm = alarms[key];\n\nif (!alarm || !alarm.silenced) return null;\n\nalarm.silenced = false;\ndelete alarm.silencedUntil;\nalarms[key] = alarm;\nglobal.set('activeAlarms', alarms);\n\nif (alarm.acknowledged || alarm.state === 'normal') return null;\n\n// Still actively abnormal after 30 min -- resume alerting by re-entering\n// the pipeline at the hysteresis gate, bypassing the rbe dedup filter\n// (which would otherwise block a same-state repeat).\nmsg.alarm_id = key;\nmsg.alarm_state = alarm.state;\nmsg.alarm_zone = alarm.zone;\nmsg.alarm_message = alarm.message;\nmsg.topic = key;\nreturn msg;\n",
        "outputs": 1,
        "x": 1010,
        "y": 500,
        "wires": [
            [
                "cb886f5692170d07"
            ]
        ]
    },
    {
        "id": "n_fn_build_status",
        "type": "function",
        "z": "487e7fdff6aeea0c",
        "name": "Build Alarm Status",
        "func": "const alarms = global.get('activeAlarms') || {};\nconst out = Object.keys(alarms).map((key) => {\n    const a = alarms[key];\n    return {\n        id: key,\n        path: a.path || null,\n        state: a.state,\n        silenced: !!a.silenced,\n        acknowledged: !!a.acknowledged,\n        silencedUntil: a.silencedUntil || null\n    };\n});\n\nmsg.statusCode = 200;\nmsg.headers = { 'Access-Control-Allow-Origin': '*' };\nmsg.payload = out;\nreturn msg;\n",
        "outputs": 1,
        "x": 350,
        "y": 620,
