    {
        "id": "9a869074e7d5744e",
        "type": "function",
        "z": "487e7fdff6aeea0c",
        "name": "Parse Notification",
        "func": "const path = msg.payload?.path || '';\nconst value = msg.payload?.value || {};\n\nconst pathParts = path.split('.');\nconst pathId = pathParts.slice(1).join('.');\n\nmsg.alarm_id = value.id || pathId || 'unknown';\nmsg.alarm_state = value.state || 'normal';\nmsg.alarm_zone = (value.zone || 'all').toLowerCase();\nmsg.alarm_message = value.message || 'Marine alarm';\nmsg.alarm_silenced = value.status?.silenced || false;\nmsg.alarm_acknowledged = value.status?.acknowledged || false;\n\nmsg.payload = msg.alarm_message;\nmsg.topic = msg.alarm_id;\n\nmsg.volume = {\n    emergency: 100,\n    alarm: 85,\n    warn: 70,\n    normal: 0\n}[msg.alarm_state] ?? 70;\n\nlet alarms = global.get('activeAlarms') || {};\n\nif (msg.alarm_state === 'normal') {\n    delete alarms[msg.alarm_id];\n} else {\n    const existing = alarms[msg.alarm_id] || {};\n    alarms[msg.alarm_id] = {\n        id: msg.alarm_id,\n        path: path,\n        state: msg.alarm_state,\n        zone: msg.alarm_zone,\n        message: msg.alarm_message,\n        // Preserve a manual silence/ack set via /alarm-action -- Signal K's\n        // own write path is auth-blocked, so it will never report these as\n        // true on its own; only \"Expire Silence\" is allowed to flip\n        // silenced back to false.\n        silenced: existing.silenced || msg.alarm_silenced,\n        acknowledged: existing.acknowledged || msg.alarm_acknowledged,\n        silencedUntil: existing.silencedUntil,\n        updated: Date.now()\n    };\n}\n\nglobal.set('activeAlarms', alarms);\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 160,
        "wires": [
